# Copia in .env e personalizza. NON committare il .env reale.

# === Opzione A: OAuth via GitHub (consigliata, default di Lovable) =========
# Crea una GitHub OAuth App: https://github.com/settings/developers
#   - Homepage URL:              il tuo BASE_URL
#   - Authorization callback URL: {BASE_URL}/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# URL pubblico HTTPS del server (senza slash finale), es. https://mcp.tuodominio.com
BASE_URL=

# === Opzione B: Bearer token (fallback, usato se le variabili GitHub sono vuote)
MCP_TOKEN=dev-change-me-please

# === Generazione script VSL con Claude ====================================
# Necessaria per i tool genera_vsl_script / genera_hook / migliora_script.
ANTHROPIC_API_KEY=

# === Rete del server HTTP =================================================
HOST=0.0.0.0
PORT=8000
